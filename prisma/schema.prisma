generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  passwordHash   String
  name           String
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  memberships        StoreUser[]
  salesCreated              Sale[]            @relation("SaleCreatedBy")
  saleReturnsCreated        SaleReturn[]      @relation("SaleReturnCreatedBy")
  purchasesCreated          Purchase[]        @relation("PurchaseCreatedBy")
  purchaseReturnsCreated    PurchaseReturn[]  @relation("PurchaseReturnCreatedBy")
  transfersCreated          StockTransfer[]   @relation("TransferCreatedBy")
}

model Store {
  id              String       @id @default(cuid())
  /// Short branch / internal name (lists, switching stores).
  name            String
  /// Long printed title on bills (e.g. PM-JAY Kendra); falls back to `name` when empty.
  billShopName    String?
  address         String?
  phone           String?
  gstin           String?
  email           String?
  /// Drug licence line(s) for dot-matrix bill footer (e.g. "RLF 20 KL 2025002347, RLF21KL 2025002336")
  drugLicenseLine String?
  /// Optional multi-line custom footer on printed bills; when empty, default is centered “Get well soon” and right-aligned “Pharmacist Sign”.
  billTerms       String?
  createdAt       DateTime     @default(now())
  users           StoreUser[]
  lots            InventoryLot[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  purchases         Purchase[]
  purchaseReturns   PurchaseReturn[]
  transfersFrom     StockTransfer[] @relation("TransfersFrom")
  transfersTo       StockTransfer[] @relation("TransfersTo")
  settings          StoreSettings?
}

model StoreSettings {
  storeId         String @id
  nextBillNo      Int    @default(1)
  nextPurchaseNo  Int    @default(1)
  nextTransferNo  Int    @default(1)
  store           Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreUser {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  role      String    @default("CASHIER") // MANAGER | CASHIER
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Supplier {
  id                  String     @id @default(cuid())
  name                String
  phone               String?
  phoneAlt            String?
  email               String?
  address             String?
  gstin               String?
  company             String?
  contactPerson       String?
  drugLicense1        String?
  drugLicense2        String?
  /// EasyTab / legacy distributor code (scode); used for imports.
  legacySupplierCode  Int?       @unique
  createdAt           DateTime   @default(now())
  purchases           Purchase[]
  inventoryLots       InventoryLot[]
}

model Product {
  id          String         @id @default(cuid())
  sku         String         @unique
  name        String
  brandId     String?
  brand       Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  genericName String?
  /// GENERIC | STATIONARY | ETHICAL | VETERINARY | JANAUSHADHI | COSMETIC | SURGICAL
  productCategory String     @default("GENERIC")
  /// CAPSULES | CREAMS | … | TABLETS | EQUIPMENT
  productType String         @default("TABLETS")
  packSize    Int            @default(1) // units per strip/pack; billing column
  unit        String         @default("unit")
  hsn         String?
  /// GST % for POS extraction from MRP-inclusive amounts (EasyTab: GST_MASTER.GSTRATE via GSTID).
  gstPct      Decimal        @default(0) @db.Decimal(9, 3)
  reorderMin  Int            @default(0)
  createdAt   DateTime       @default(now())
  lots        InventoryLot[]
  saleLines   SaleLine[]
  purchaseLines     PurchaseLine[]
  transferLines     StockTransferLine[]

  @@index([brandId])
  @@index([name])
  @@index([genericName])
}

model InventoryLot {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  /// Last-known distributor for this batch (purchase posting or EasyTab import via scode).
  supplierId        String?
  batchNo           String
  expiryDate        DateTime
  quantity          Int
  costPrice         Decimal
  mrp               Decimal
  /// Default selling rate per pack (POS-style); often ≤ MRP.
  saleRate          Decimal  @default(0)
  salesDiscountPct  Decimal  @default(0)
  salesDiscountRs   Decimal  @default(0)
  stockCorrected    Boolean  @default(false) // temporary shop count — highlighted in Stock UI
  createdAt         DateTime @default(now())
  /// Row version; updates on any lot write (including qty-only).
  updatedAt         DateTime @updatedAt
  /// Last change to sale pricing / MRP / cost — drives purchase line-default S.Disc (not bumped on qty-only POS).
  pricingUpdatedAt  DateTime @default(now())
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleLines       SaleLine[]
  transferLines   StockTransferLine[]

  @@index([storeId, expiryDate])
  @@index([storeId, productId])
  @@index([storeId, supplierId])
  @@index([storeId, quantity])
  @@index([storeId, batchNo, productId])
  @@index([supplierId])
  @@unique([storeId, productId, batchNo, expiryDate])
}

model Purchase {
  id          String         @id @default(cuid())
  storeId     String
  purchaseNo  Int
  supplierId  String
  invoiceRef  String?
  invoiceDate DateTime?
  notes       String?
  /// When true, purchase is finalized — supplier/invoice/notes and lines are view only (no API re-open).
  complete    Boolean        @default(false)
  /// CASH | CARD | UPI | CREDIT — how the supplier bill was / will be settled.
  paymentMode String         @default("CASH")
  /// GST-inclusive amount settled against this bill (net after returns).
  amountPaid  Decimal        @default(0) @db.Decimal(12, 2)
  /// Filter/badge; true when settled. Outstanding uses amountPaid vs net.
  paid        Boolean        @default(true)
  /// Calendar date payment was made (null when unpaid).
  paidAt      DateTime?
  /// Last 4 of UPI/card txn / UTR (null for cash/credit or unpaid).
  paymentRefLast4 String?    @db.VarChar(4)
  createdAt   DateTime       @default(now())
  createdById String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  createdBy   User             @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  lines       PurchaseLine[]
  returns     PurchaseReturn[]

  @@unique([storeId, purchaseNo])
  @@index([storeId, createdAt])
  @@index([storeId, invoiceDate])
  @@index([storeId, complete])
  @@index([storeId, paid])
  @@index([supplierId])
}

model PurchaseLine {
  id                  String   @id @default(cuid())
  purchaseId          String
  productId           String
  batchNo             String
  expiryDate          DateTime
  quantity            Int // smallest inventory units (tablets, etc.); matches lot qty / POS
  costPrice           Decimal // per pack (trade rate per strip/bottle)
  mrp                 Decimal // printed MRP per pack
  pack                Int      @default(1) // units per pack — used to convert cost/MRP to line value
  purchaseDiscountPct Decimal  @default(0)
  purchaseDiscountRs  Decimal  @default(0)
  schemeDiscountPct   Decimal  @default(0)
  schemeDiscountRs    Decimal  @default(0)
  salesDiscountPct    Decimal  @default(0)
  salesDiscountRs     Decimal  @default(0)
  freeQty             Int      @default(0) // free smallest units (scheme); same unit as quantity
  gstPct              Decimal  @default(0)
  purchase            Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])
  returnLines         PurchaseReturnLine[]

  @@index([purchaseId])
  @@index([productId])
}

model PurchaseReturn {
  id             String   @id @default(cuid())
  storeId        String
  purchaseId     String
  createdAt      DateTime @default(now())
  createdById    String
  note           String?
  /// Supplier credit note reference (optional).
  creditNoteNo   String?
  creditNoteDate DateTime?
  /// GST-inclusive credit total (sum of line credits).
  total          Decimal  @db.Decimal(12, 2)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  lines          PurchaseReturnLine[]

  @@index([storeId, createdAt])
  @@index([purchaseId])
}

model PurchaseReturnLine {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseLineId   String
  qty              Int
  /// GST-inclusive credit for this line (proportional to purchase line payable).
  creditTotal      Decimal        @db.Decimal(12, 2)
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseLine     PurchaseLine   @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)

  @@index([purchaseLineId])
}

model Sale {
  id             String      @id @default(cuid())
  storeId        String
  billNo         Int
  createdAt      DateTime    @default(now())
  createdById    String
  customerName   String?
  customerPhone  String?
  doctorName     String?
  subtotal       Decimal
  discount       Decimal     @default(0)
  tax            Decimal     @default(0)
  total          Decimal
  paymentMode    String      @default("CASH") // CASH | CARD | UPI | CREDIT
  /// Amount tendered (cash); change = cashReceived − total. Null if not cash / not entered.
  cashReceived   Decimal?    @db.Decimal(12, 2)
  /// False for credit bills until payment is collected; toggle anytime.
  paid           Boolean     @default(true)
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy      User        @relation("SaleCreatedBy", fields: [createdById], references: [id])
  lines          SaleLine[]
  returns        SaleReturn[]

  @@unique([storeId, billNo])
  @@index([storeId, createdAt])
}

model SaleLine {
  id             String       @id @default(cuid())
  saleId         String
  productId      String
  lotId          String
  qty            Int
  rate           Decimal
  amount         Decimal
  discountPct    Decimal      @default(0)
  discountAmount Decimal      @default(0)
  gstPct         Decimal      @default(0)
  gstAmount      Decimal      @default(0)
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  lot            InventoryLot @relation(fields: [lotId], references: [id])
  returnLines    SaleReturnLine[]

  @@index([saleId])
  @@index([productId])
  @@index([lotId])
}

model SaleReturn {
  id             String   @id @default(cuid())
  storeId        String
  saleId         String
  createdAt      DateTime @default(now())
  createdById    String
  note           String?
  /// GST-inclusive credit total (sum of line refunds).
  total          Decimal  @db.Decimal(12, 2)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("SaleReturnCreatedBy", fields: [createdById], references: [id])
  lines          SaleReturnLine[]

  @@index([storeId, createdAt])
  @@index([saleId])
}

model SaleReturnLine {
  id            String     @id @default(cuid())
  saleReturnId  String
  saleLineId    String
  qty           Int
  /// GST-inclusive refund for this line (proportional to billed line).
  refundTotal   Decimal    @db.Decimal(12, 2)
  saleReturn    SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleLine      SaleLine   @relation(fields: [saleLineId], references: [id], onDelete: Restrict)

  @@index([saleLineId])
}

model StockTransfer {
  id           String   @id @default(cuid())
  transferNo   Int
  fromStoreId  String
  toStoreId    String
  notes        String?
  status       String   @default("COMPLETED") // COMPLETED (v1); room for DRAFT | IN_TRANSIT later
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  createdById  String

  fromStore    Store    @relation("TransfersFrom", fields: [fromStoreId], references: [id], onDelete: Cascade)
  toStore      Store    @relation("TransfersTo", fields: [toStoreId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("TransferCreatedBy", fields: [createdById], references: [id])
  lines        StockTransferLine[]

  @@unique([fromStoreId, transferNo])
  @@index([fromStoreId, createdAt])
  @@index([toStoreId, createdAt])
}

model StockTransferLine {
  id           String   @id @default(cuid())
  transferId   String
  sourceLotId  String
  productId    String
  batchNo      String
  expiryDate   DateTime
  quantity     Int

  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sourceLot    InventoryLot  @relation(fields: [sourceLotId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([sourceLotId])
  @@index([productId])
}
